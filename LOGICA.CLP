//////////////////////////////////////////////////////////////////////////
// Valor padrão: 100 = 1 segundo
//////////////////////////////////////////////////////////////////////////
tempoAlternancia = 100;

//////////////////////////////////////////////////////////////////////////
// 1) Disparo: conta enquanto há trem e cai após cada fim,
//    para a contagem reiniciar
//////////////////////////////////////////////////////////////////////////
SEL     (sensorTremPresente)
EN      (fim_tmpAlternancia)
MEMO    (dsp_tmpAlternancia)

//////////////////////////////////////////////////////////////////////////
// 2) Pulso de troca: fim da contagem com trem presente
//////////////////////////////////////////////////////////////////////////
SEL     (fim_tmpAlternancia)
E       (sensorTremPresente)
MEMO    (auxPulsoTroca)

//////////////////////////////////////////////////////////////////////////
// 3) Set e reset da vez da B, a partir do pulso de troca
//////////////////////////////////////////////////////////////////////////
SEL     (auxPulsoTroca)
EN      (auxVezDaLampadaB)
MEMO    (auxSetB)

SEL     (auxPulsoTroca)
E       (auxVezDaLampadaB)
MEMO    (auxResetB)

//////////////////////////////////////////////////////////////////////////
// 4) Selo da vez da B: liga no set, desliga no reset,
//    e zera quando não há trem
//////////////////////////////////////////////////////////////////////////
SEL     (auxSetB)
OU      (auxVezDaLampadaB)
EN      (auxResetB)
E       (sensorTremPresente)
MEMO    (auxVezDaLampadaB)

//////////////////////////////////////////////////////////////////////////
// 5) Lâmpada A: trem presente e vez não é da B
//////////////////////////////////////////////////////////////////////////
SEL     (sensorTremPresente)
EN      (auxVezDaLampadaB)
MEMO    (lampadaA)

//////////////////////////////////////////////////////////////////////////
// 6) Lâmpada B: trem presente e vez é da B
//////////////////////////////////////////////////////////////////////////
SEL     (sensorTremPresente)
E       (auxVezDaLampadaB)
MEMO    (lampadaB)
